<?xml version = "1.0"?>
<robot name="rrr_arm">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0.01"/>
        <geometry>
          <cylinder radius="0.06" length="0.02"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
    </link>
    <joint name="joint1_yaw" type="revolute">
      <parent link="base_link"/>
      <child link="link1_turret"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="20" velocity="3"/>
    </joint>
    <link name="link1_turret">
      <visual>
        <orgin xyz="0 0 0.05"/>
        <geometry>
          <cylinder radius="0.02" length="0.10"/>
        </geometry>
        <material name="dark">
          <color rgba="0.3 0.3 0.3 1"/>. 
        </material>
      </visual>
    </link>  
</robot>
