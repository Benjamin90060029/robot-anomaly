<?xml version = "1.0"?>
<robot name="rrr_arm">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0.01"/>
        <geometry>
          <cylinder radius="0.06" length="0.02"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
    </link>
    <joint name="joint1_yaw" type="revolute">
      <parent link="base_link"/>
      <child link="link1_turret"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="20" velocity="3"/>
    </joint>
    <link name="link1_turret">
      <visual>
        <origin xyz="0 0 0.05"/>
        <geometry>
          <cylinder radius="0.02" length="0.10"/>
        </geometry>
        <material name="dark">
          <color rgba="0.3 0.3 0.3 1"/>. 
        </material>
      </visual>
    </link> 
        <joint name="joint2_shoulder" type="revolute">
      <parent link="link1_turret"/>
      <child link="link2_upper"/>
      <origin xyz="0 0 0.10"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.57" upper="1.57" effort="20" velocity="3"/>
    </joint>

    <link name="link2_upper">
      <visual>
        <origin xyz="0.125 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.25"/>
        </geometry>
        <material name="purple">
          <color rgba="0.33 0.29 0.72 1"/>
        </material>
      </visual>
    </link>
        <joint name="joint3_elbow" type="revolute">
      <parent link="link2_upper"/>
      <child link="link3_fore"/>
      <origin xyz="0.25 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-2.6" upper="2.6" effort="20" velocity="3"/>
    </joint>

    <link name="link3_fore">
      <visual>
        <origin xyz="0.10 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.018" length="0.20"/>
        </geometry>
        <material name="lilac">
          <color rgba="0.5 0.47 0.87 1"/>
        </material>
      </visual>
    </link>

    <joint name="ee_fixed" type="fixed">
      <parent link="link3_fore"/>
      <child link="ee_link"/>
      <origin xyz="0.20 0 0"/>
    </joint>

    <link name="ee_link">
      <visual>
        <geometry>
          <sphere radius="0.025"/>
        </geometry>
        <material name="coral">
          <color rgba="0.85 0.35 0.19 1"/>
        </material>
      </visual>
    </link>
</robot>
